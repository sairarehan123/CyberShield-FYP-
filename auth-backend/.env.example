# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

PORT=4000
NODE_ENV=development

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public key: legacy "anon" key OR new "publishable" key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key: legacy "service_role" key OR new "secret" key. BACKEND ONLY. Used only for logout.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Comma-separated browser origins allowed by CORS (only matters for Expo Web).
# Native apps (Android/iOS) do not send an Origin header, so they are not affected.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
