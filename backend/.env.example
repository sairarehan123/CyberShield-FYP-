# Copy this file to .env (never commit .env) and fill in the values.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Which assessments must be finished before the training, quiz and e-mails unlock.
TRAINING_REQUIRED_THEORIES=sebis,pmt,tpb,ttat

# Progress check timing. REAL values (minutes): 1440 / 10080 / 1440. Short values are for demos/testing only.
DRILL_DELAY_MINUTES=1440
DRILL_PERIOD_MINUTES=10080
MESSAGE_WINDOW_MINUTES=1440

# Where the "this was a drill" page lives (the backend address the PHONE can reach).
PUBLIC_BASE_URL=http://192.168.18.142:8000

# E-mail for simulated messages (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
